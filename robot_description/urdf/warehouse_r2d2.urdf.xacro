<?xml version="1.0"?>
<robot name="r2d2"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <!-- Цвет корпуса -->
  <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Цвет ног -->
  <gazebo reference="right_leg">
      <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="left_leg">
      <material>Gazebo/White</material>
  </gazebo>

  <!-- Цвет оснований -->
  <gazebo reference="right_base">
      <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="left_base">
      <material>Gazebo/White</material>
  </gazebo>

  <!-- Цвет головы -->
  <gazebo reference="head">
      <material>Gazebo/White</material>
  </gazebo>

  <!-- Цвет объектива -->
  <gazebo reference="camera_link">
      <material>Gazebo/Black</material>
  </gazebo>
<xacro:macro name="wheel" params="name parent x">

    <link name="${name}">
        <visual>
            <origin xyz="0 0 0" rpy="1.57075 0 0"/>
            <geometry>
                <cylinder length="0.1" radius="0.035"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.57075 0 0"/>
            <geometry>
                <cylinder length="0.1" radius="0.035"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia
                ixx="0.000113958"
                ixy="0"
                ixz="0"
                iyy="0.00006125"
                iyz="0"
                izz="0.000113958"/>
        </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
        <parent link="${parent}"/>
        <child link="${name}"/>

        <origin xyz="${x} 0 -0.085" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

        <limit effort="3.0" velocity="20.0"/>
    </joint>
    
    <gazebo reference="${name}">
        <material>Gazebo/Black</material>
    </gazebo>

</xacro:macro>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.6" radius="0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
        <geometry>
            <cylinder length="0.6" radius="0.2"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <mass value="5.0"/>

        <inertia
            ixx="0.2"
            ixy="0"
            ixz="0"
            iyy="0.2"
            iyz="0"
            izz="0.1"/>
    </inertial>
  </link>

  <link name="right_leg">
    <visual>
      <geometry>
        <box size="0.6 0.1 0.2"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0 0 -0.3"/>
      <material name="white"/>
    </visual>

    <collision>
        <origin xyz="0 0 -0.3" rpy="0 1.57075 0"/>
        <geometry>
            <box size="0.6 0.1 0.2"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 -0.3" rpy="0 0 0"/>

        <mass value="0.5"/>

        <inertia
            ixx="0.015417"
            ixy="0"
            ixz="0"
            iyy="0.016667"
            iyz="0"
            izz="0.002083"/>
    </inertial>
  </link>

  <joint name="base_to_right_leg" type="fixed">
    <parent link="base_link"/>
    <child link="right_leg"/>
    <origin xyz="0 -0.22 0.25"/>
  </joint>

  <link name="right_base">
    <visual>
      <geometry>
        <box size="0.4 0.1 0.1"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.4 0.1 0.1"/>
      </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <mass value="0.3"/>

        <inertia
            ixx="0.0005"
            ixy="0"
            ixz="0"
            iyy="0.00425"
            iyz="0"
            izz="0.00425"/>
    </inertial>
  </link>

  <joint name="right_base_joint" type="fixed">
    <parent link="right_leg"/>
    <child link="right_base"/>
    <origin xyz="0 0 -0.6"/>
  </joint>

<xacro:wheel name="right_front_wheel"
             parent="right_base"
             x="0.133333333333"/>

<xacro:wheel name="right_back_wheel"
             parent="right_base"
             x="-0.133333333333"/>

  <link name="left_leg">
    <visual>
      <geometry>
        <box size="0.6 0.1 0.2"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0 0 -0.3"/>
      <material name="white"/>
    </visual>

    <collision>
        <origin xyz="0 0 -0.3" rpy="0 1.57075 0"/>
        <geometry>
            <box size="0.6 0.1 0.2"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 -0.3" rpy="0 0 0"/>

        <mass value="0.5"/>

        <inertia
            ixx="0.015417"
            ixy="0"
            ixz="0"
            iyy="0.016667"
            iyz="0"
            izz="0.002083"/>
    </inertial>
  </link>

  <joint name="base_to_left_leg" type="fixed">
    <parent link="base_link"/>
    <child link="left_leg"/>
    <origin xyz="0 0.22 0.25"/>
  </joint>

  <link name="left_base">
    <visual>
      <geometry>
        <box size="0.4 0.1 0.1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.1 0.1"/>
      </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <mass value="0.3"/>

        <inertia
            ixx="0.0005"
            ixy="0"
            ixz="0"
            iyy="0.00425"
            iyz="0"
            izz="0.00425"/>
    </inertial>
  </link>

  <joint name="left_base_joint" type="fixed">
    <parent link="left_leg"/>
    <child link="left_base"/>
    <origin xyz="0 0 -0.6"/>
  </joint>

<xacro:wheel name="left_front_wheel"
             parent="left_base"
             x="0.133333333333"/>

<xacro:wheel name="left_back_wheel"
             parent="left_base"
             x="-0.133333333333"/>


<link name="head">
    <visual>
        <geometry>
            <sphere radius="0.2"/>
        </geometry>
        <material name="white"/>
    </visual>

    <collision>
        <geometry>
            <sphere radius="0.2"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <mass value="1.0"/>

        <inertia
            ixx="0.016"
            ixy="0"
            ixz="0"
            iyy="0.016"
            iyz="0"
            izz="0.016"/>
    </inertial>
</link>

<link name="camera_link">
    <visual>
        <geometry>
            <sphere radius="0.02"/>
        </geometry>
        <material name="black"/>
    </visual>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia
            ixx="0.0000016"
            ixy="0"
            ixz="0"
            iyy="0.0000016"
            iyz="0"
            izz="0.0000016"/>
    </inertial>
</link>

<joint name="head_to_camera" type="fixed">
    <parent link="head"/>
    <child link="camera_link"/>

    <origin xyz="0.2 0 0" rpy="0 0 0"/>
</joint>

<joint name="head_swivel" type="revolute">
    <parent link="base_link"/>
    <child link="head"/>

    <origin xyz="0 0 0.3" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
        lower="-1.570796"
        upper="1.570796"
        effort="5.0"
        velocity="1.0"/>
</joint>

</robot>