<?xml version="1.0"?>
<sdf version="1.7">
  <model name="stag_hd13_test">

    <static>true</static>

    <link name="marker_link">

      <!-- Белая подложка под маркер -->
      <visual name="backing">
        <pose>0 0 -0.001 0 0 0</pose>

        <geometry>
          <box>
            <size>0.092 0.092 0.002</size>
          </box>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <!-- Лицевая сторона HD13 -->
      <visual name="marker_image">
        <pose>0 0 0.001 0 0 0</pose>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.09 0.09</size>
          </plane>
        </geometry>

        <material>
          <script>
            <uri>file:///home/ilya/warehouse_project/models/stag_hd13_test/materials/scripts</uri>
            <uri>file:///home/ilya/warehouse_project/models/stag_hd13_test/materials/textures</uri>
            <name>STag/HD13</name>
          </script>
        </material>

        <cast_shadows>false</cast_shadows>
      </visual>

    </link>
  </model>
</sdf>
